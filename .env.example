# ==============================================================================
# GGD META AI - WhatsApp Bot & PostgreSQL Configuration
# ==============================================================================

# WhatsApp Bot Automation Settings
BOT_NAME=GGD META AI
SESSION_ID=cloudsql_baileys_session
PHONE_NUMBER=
AUTO_TAG_ENABLED=true
AUTO_TAG_TRIGGER=all
AUTO_TAG_KEYWORD=.everyone
SILENT_TAG_ENABLED=false
STATUS_AUTO_VIEW=true
STATUS_AUTO_REACT=true
STATUS_REACT_EMOJI=❤️
TAG_COOLDOWN_SECONDS=3
MENTION_FORMAT=announcement

# ==============================================================================
# Google Cloud SQL (Platform-Provided in AI Studio & Cloud Run)
# ==============================================================================
# In Google Cloud Run / AI Studio, Cloud SQL Developer Edition automatically injects:
# SQL_HOST, SQL_USER, SQL_PASSWORD, SQL_DB_NAME
SQL_HOST=
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB_NAME=baileys_db
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

# ==============================================================================
# Vercel / Neon / Supabase Deployment (Environmental Variables for Vercel)
# ==============================================================================
# Set this in your Vercel Project Settings > Environment Variables:
# DATABASE_URL=postgresql://[user]:[password]@[host]:5432/[dbname]?sslmode=require
DATABASE_URL=

# Fallback Individual Database Parameters
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=baileys_db
DB_SSL=false
INSTANCE_CONNECTION_NAME=

# ==============================================================================
# Vercel Frontend Direct Connection to Persistent Backend
# ==============================================================================
# Vercel deploys the frontend directly. Requests to /api/* and /send-broadcast are
# automatically routed via vercel.json rewrites or direct client fetch:
VITE_BACKEND_URL=https://ais-dev-hsblii7uqrvcik2nynq2rw-44864405563.europe-west2.run.app
BACKEND_URL=https://ais-dev-hsblii7uqrvcik2nynq2rw-44864405563.europe-west2.run.app
PORT=3000


# ==============================================================================
# Optional Redis & Message Queue (In-memory fallback active by default)
# ==============================================================================
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Debugging
DEBUG_BAILEYS=false